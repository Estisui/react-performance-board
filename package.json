    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9"
  }
}
